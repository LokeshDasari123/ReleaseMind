# Required for both the memory-free baseline and memory-augmented assessments.
# For Groq, set the Groq key in OPENAI_API_KEY, LLM_BASE_URL below, and a Groq model in LLM_MODEL.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Persistent local memory is the default and works without a Hindsight service
RETRIEVAL_PROVIDER=local
DATABASE_PATH=../data/releasemind.sqlite3

# Optional Hindsight service. For Cloud use https://api.hindsight.vectorize.io
# and set its bearer token. A local unauthenticated service may leave the key blank.
# RETRIEVAL_PROVIDER=hindsight
# HINDSIGHT_BASE_URL=http://localhost:8888
# HINDSIGHT_API_KEY=
# HINDSIGHT_BANK_ID=releasemind

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
